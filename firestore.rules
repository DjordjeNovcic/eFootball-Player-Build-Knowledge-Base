rules_version = '2';

// Build Lab: one document per squad (mine or a friend's).
//   squads/{squadId} = { owner, members[], name, kind, inviteCode?, joinCode?, json, updatedAt, updatedBy }
// Only members can read or write a squad. The owner manages members and the invite
// code; anyone holding a valid invite link can add *themselves* and nothing else;
// a member can leave. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /squads/{squadId} {
      function signedIn() { return request.auth != null; }
      function uid() { return request.auth.uid; }
      function isMember() { return signedIn() && uid() in resource.data.members; }
      function isOwner() { return signedIn() && uid() == resource.data.owner; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      function validShape() {
        let d = request.resource.data;
        return d.owner is string && d.members is list && d.members.size() <= 20
          && d.name is string && d.name.size() <= 60
          && d.json is string && d.json.size() < 900000;
      }

      // A member (not the owner) may edit the squad's content, but not who owns it,
      // who is in it, or its invite code.
      function memberEdit() {
        return isMember() && validShape()
          && !changed().hasAny(['owner', 'members', 'inviteCode']);
      }

      // Holder of the invite link adds exactly themselves.
      function joining() {
        return signedIn() && !(uid() in resource.data.members)
          && resource.data.inviteCode is string && resource.data.inviteCode.size() >= 20
          && request.resource.data.joinCode == resource.data.inviteCode
          && changed().hasOnly(['members', 'joinCode'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && uid() in request.resource.data.members;
      }

      // A non-owner member removes exactly themselves.
      function leaving() {
        return isMember() && !isOwner()
          && changed().hasOnly(['members'])
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(uid() in request.resource.data.members);
      }

      allow read: if isMember();
      allow create: if signedIn() && validShape()
        && request.resource.data.owner == uid()
        && request.resource.data.members == [uid()];
      allow update: if (isOwner() && validShape() && request.resource.data.owner == resource.data.owner
                        && uid() in request.resource.data.members)
                    || memberEdit() || joining() || leaving();
      allow delete: if isOwner();
    }

    // Published builds by the site owner (CoinPlayTV), one per card:
    //   creatorBuilds/{playerId} = { owner, playerId, name, position, json, updatedAt }
    // Public: anyone can read them, even without an account; only the owner
    // (OWNER_UID in firebase-config.js) can publish, edit or unpublish.
    match /creatorBuilds/{playerId} {
      function isCreator() { return request.auth != null && request.auth.uid == "GI1MLGbsl2a81ILmlr88OvtHocm2"; }
      allow read: if true;
      allow create, update: if isCreator()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.playerId == playerId
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.json is string && request.resource.data.json.size() < 200000;
      allow delete: if isCreator();
    }
  }
}
